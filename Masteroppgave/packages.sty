    \newcommand{\draftciteauthor}[1]{%
        \ifcsname draftciteauthor@#1\endcsname
            \csname draftciteauthor@#1\endcsname
        \else
            #1%
        \fi
    }
    \newcommand{\draftciteyear}[1]{%
        \ifcsname draftciteyear@#1\endcsname
            \csname draftciteyear@#1\endcsname
        \else
            n.d.%
        \fi
    }
    \newcommand{\draftciteparenlist}[1]{%
        \def\draftcitesep{}%
        \@for\draftcitekey:=#1\do{%
            \draftcitesep\draftciteauthor{\draftcitekey}, \draftciteyear{\draftcitekey}%
            \def\draftcitesep{; }%
        }%
    }
    \newcommand{\draftcitetextlist}[1]{%
        \def\draftcitesep{}%
        \@for\draftcitekey:=#1\do{%
            \draftcitesep\draftciteauthor{\draftcitekey}~(\draftciteyear{\draftcitekey})%
            \def\draftcitesep{; }%
        }%
    }
    \renewcommand{\cite}[2][]{(\draftciteparenlist{#2})}
    \newcommand{\parencite}[2][]{(\draftciteparenlist{#2})}
    \newcommand{\textcite}[2][]{\draftcitetextlist{#2}}
    \newcommand{\autocite}[2][]{(\draftciteparenlist{#2})}
    \makeatother
